# Copie este arquivo para ".env" (git-ignorado) e preencha com valores reais locais.
# Em produção (Railway), estas mesmas chaves são configuradas como variáveis de ambiente
# do serviço, não via arquivo .env.

ENVIRONMENT=development

# Banco de staging/controle da plataforma (PostgreSQL nativo local). Em produção, aponte
# para a URL do plugin Postgres do Railway (aceita tanto "postgresql+asyncpg://" quanto o
# formato padrão "postgresql://"/"postgres://" que o Railway injeta — normalizado em
# app/core/config.py).
DATABASE_URL=postgresql+asyncpg://migracao_app:CHANGE_ME@localhost:5432/migracao_platform

# Chave de assinatura do cookie de sessão do portal — o default só serve para
# desenvolvimento local; em produção, gere um valor aleatório forte (ex.: `openssl rand
# -hex 32`) e NUNCA reaproveite entre ambientes.
SECRET_KEY=dev-secret-key-troque-em-producao

# Reservado para a camada de integração de destino (Oracle) — configurado a partir da Fase 3+.
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
